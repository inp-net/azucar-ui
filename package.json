{
    "name": "azucar-ui",
    "version": "0.0.12",
    "description": "Svelte component library that makes your app sweet.",
    "author": "Matteo Planchet <matteo.planchet@gmail.com>",
    "license": "MIT",
    "private": false,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && npm run prepack",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "prepack": "svelte-kit sync && svelte-package && publint",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check .",
        "test:unit": "vitest",
        "test": "npm run test:unit -- --run"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./base.css": "./dist/styles/base.css",
        "./tokens.css": "./dist/styles/tokens.css",
        "./fonts/*": "./dist/assets/fonts/*"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/package": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@vitest/browser": "^5.0.3",
        "lefthook": "^2.1.12",
        "lightningcss": "^1.33.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "publint": "^0.3.23",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.5",
        "typescript": "^6.0.3",
        "vite": "^8.2.0",
        "vitest": "^5.0.3",
        "vitest-browser-svelte": "^3.0.0"
    },
    "keywords": [
        "svelte",
        "component",
        "library",
        "ui",
        "design system",
        "css",
        "javascript",
        "typescript"
    ],
    "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
    "dependencies": {
        "@lucide/svelte": "^1.3.0",
        "csstype": "^3.2.3"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
