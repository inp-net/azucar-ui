{
    "name": "azucar-ui",
    "version": "0.0.2",
    "description": "Svelte component library that makes your app sweet.",
    "author": "Matteo Planchet <matteo.planchet@gmail.com>",
    "license": "MIT",
    "private": false,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && npm run prepack",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "prepack": "svelte-kit sync && svelte-package && publint",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check .",
        "test:unit": "vitest",
        "test": "npm run test:unit -- --run"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./base.css": "./dist/styles/base.css",
        "./tokens.css": "./dist/styles/tokens.css",
        "./fonts/*": "./dist/assets/fonts/*"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/kit": "^2.55.0",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@vitest/browser": "^4.1.1",
        "playwright": "^1.58.2",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.1",
        "publint": "^0.3.18",
        "svelte": "^5.55.0",
        "svelte-check": "^4.4.5",
        "typescript": "^6.0.2",
        "vite": "^8.0.2",
        "vitest": "^4.1.1",
        "vitest-browser-svelte": "^2.1.0"
    },
    "keywords": [
        "svelte", "component", "library", "ui", "design system", "css", "javascript", "typescript"
    ],
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
    "dependencies": {
        "@lucide/svelte": "^1.3.0",
        "csstype": "^3.2.3"
    }
}
